---

---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Press+Start+2P&display=swap"
			rel="stylesheet"
		/>
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>Mona Mayhem – GitHub Contribution Battle Arena</title>
	</head>
	<body>
		<header>
			<h1>Mona Mayhem</h1>
			<p class="tagline">GitHub Contribution Battle Arena</p>
		</header>

		<form id="battle-form">
			<div class="fighters">
				<div class="fighter">
					<label for="player1">Player 1</label>
					<input id="player1" name="player1" type="text" placeholder="GitHub username" required />
				</div>
				<span class="vs">VS</span>
				<div class="fighter">
					<label for="player2">Player 2</label>
					<input id="player2" name="player2" type="text" placeholder="GitHub username" required />
				</div>
			</div>
			<button type="submit" id="battle-btn">Battle!</button>
		</form>

		<section id="results" aria-live="polite"></section>

		<style is:global>
			:root {
				color-scheme: dark;
				--background: #0a0a1a;
				--green: #5fed83;
				--purple: #8a2be2;
				--panel: #121225;
				--text: #f5f5ff;
				--muted: #aaaabd;
				--danger: #ff5277;
			}

			* {
				box-sizing: border-box;
			}

			body {
				margin: 0;
				min-height: 100vh;
				display: flex;
				flex-direction: column;
				align-items: center;
				gap: 2.25rem;
				overflow-x: hidden;
				padding: clamp(2rem, 6vw, 4.5rem) 1rem;
				background:
					radial-gradient(circle at 50% 15%, rgb(138 43 226 / 14%), transparent 32rem),
					var(--background);
				color: var(--text);
				font-family: 'Press Start 2P', monospace;
				line-height: 1.6;
			}

			body::before,
			body::after {
				position: fixed;
				inset: 0;
				z-index: 100;
				pointer-events: none;
				content: '';
			}

			body::before {
				background: repeating-linear-gradient(
					to bottom,
					transparent 0,
					transparent 3px,
					rgb(0 0 0 / 25%) 3px,
					rgb(0 0 0 / 25%) 5px
				);
				opacity: 0.03;
			}

			body::after {
				background:
					linear-gradient(90deg, rgb(95 237 131 / 2%), rgb(138 43 226 / 3%), rgb(95 237 131 / 2%)),
					radial-gradient(circle, transparent 48%, rgb(0 0 0 / 72%) 130%);
			}

			header,
			#battle-form,
			#results {
				position: relative;
				z-index: 1;
			}

			header {
				text-align: center;
			}

			h1 {
				margin: 0;
				color: var(--green);
				font-size: clamp(1.8rem, 6vw, 3.8rem);
				letter-spacing: 0.08em;
				line-height: 1.35;
				text-shadow:
					0 0 4px #fff,
					0 0 10px var(--green),
					0 0 24px var(--green),
					0 0 44px var(--purple);
				animation: neon-pulse 2.8s ease-in-out infinite;
			}

			.tagline {
				margin: 0.8rem 0 0;
				color: var(--purple);
				font-size: clamp(0.55rem, 2vw, 0.8rem);
				letter-spacing: 0.12em;
				text-shadow: 0 0 7px var(--purple);
			}

			#battle-form {
				width: 100%;
				max-width: 760px;
				display: flex;
				flex-direction: column;
				align-items: center;
				gap: 1.5rem;
			}

			.fighters {
				width: 100%;
				display: flex;
				flex-wrap: wrap;
				align-items: center;
				justify-content: center;
				gap: 1.25rem;
			}

			.fighter {
				flex: 1 1 200px;
				display: flex;
				flex-direction: column;
				gap: 0.6rem;
				opacity: 0;
				animation: float-in-left 700ms cubic-bezier(0.2, 0.8, 0.2, 1) forwards;
			}

			.fighter:last-child {
				animation-name: float-in-right;
				animation-delay: 140ms;
			}

			.fighter label {
				color: var(--muted);
				font-size: 0.65rem;
				letter-spacing: 0.08em;
			}

			.fighter input {
				width: 100%;
				padding: 0.9rem;
				background: rgb(5 5 17 / 82%);
				border: 2px solid var(--green);
				border-radius: 0;
				box-shadow:
					inset 0 0 12px rgb(95 237 131 / 8%),
					0 0 8px rgb(95 237 131 / 24%);
				color: var(--text);
				font-family: inherit;
				font-size: 0.7rem;
				line-height: 1.4;
				outline: 2px solid transparent;
				outline-offset: 3px;
				transition:
					box-shadow 180ms ease,
					outline-color 180ms ease;
			}

			.fighter:last-child input {
				border-color: var(--purple);
				box-shadow:
					inset 0 0 12px rgb(138 43 226 / 10%),
					0 0 8px rgb(138 43 226 / 28%);
			}

			.fighter input:focus {
				outline-color: var(--green);
				box-shadow:
					inset 0 0 15px rgb(95 237 131 / 15%),
					0 0 8px var(--green),
					0 0 20px rgb(95 237 131 / 48%);
			}

			.fighter:last-child input:focus {
				outline-color: var(--purple);
				box-shadow:
					inset 0 0 15px rgb(138 43 226 / 18%),
					0 0 8px var(--purple),
					0 0 20px rgb(138 43 226 / 55%);
			}

			.fighter input::placeholder {
				color: #75758a;
			}

			.vs {
				background: linear-gradient(110deg, var(--green), var(--purple), var(--green));
				background-clip: text;
				background-size: 250% 250%;
				color: transparent;
				font-size: 1.1rem;
				font-weight: bold;
				filter: drop-shadow(0 0 7px var(--purple));
				animation:
					gradient-shift 2.5s linear infinite,
					vs-pulse 1.5s ease-in-out infinite;
			}

			#battle-btn {
				padding: 0.9rem 2.5rem;
				background: linear-gradient(110deg, var(--green), var(--purple), var(--green));
				background-position: 0% 50%;
				background-size: 220% 100%;
				border: 2px solid var(--text);
				border-radius: 0;
				box-shadow:
					5px 5px 0 var(--purple),
					0 0 14px rgb(95 237 131 / 55%);
				color: #fff;
				font-family: inherit;
				font-size: 0.75rem;
				text-transform: uppercase;
				cursor: pointer;
				transition:
					transform 150ms ease,
					box-shadow 150ms ease,
					filter 150ms ease;
			}

			#battle-btn:hover:not(:disabled) {
				filter: brightness(1.16);
				transform: translate(-2px, -2px);
				box-shadow:
					7px 7px 0 var(--purple),
					0 0 12px var(--green),
					0 0 28px rgb(138 43 226 / 65%);
			}

			#battle-btn:focus-visible {
				outline: 3px solid var(--green);
				outline-offset: 5px;
			}

			#battle-btn:active:not(:disabled) {
				transform: translate(5px, 5px);
				box-shadow: 0 0 16px var(--purple);
			}

			#battle-btn:disabled {
				background: #3e3e53;
				border-color: #686879;
				box-shadow: 3px 3px 0 #27273b;
				color: #aaaabd;
				cursor: not-allowed;
			}

			#results {
				width: 100%;
				max-width: 1100px;
				display: flex;
				flex-direction: column;
				align-items: center;
				gap: 1rem;
				text-align: center;
			}

			#results .results-row {
				width: 100%;
				display: grid;
				grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
				align-items: center;
				gap: 1.25rem;
			}

			#results .player-result {
				position: relative;
				min-width: 0;
				overflow: hidden;
				padding: 1.25rem;
				background: linear-gradient(145deg, rgb(18 18 37 / 96%), rgb(9 9 24 / 96%));
				border: 2px solid var(--green);
				border-radius: 0;
				box-shadow:
					inset 0 0 24px rgb(95 237 131 / 5%),
					0 0 10px rgb(95 237 131 / 30%);
				animation: card-reveal 550ms ease-out both;
			}

			#results .player-result:last-child {
				border-color: var(--purple);
				box-shadow:
					inset 0 0 24px rgb(138 43 226 / 7%),
					0 0 10px rgb(138 43 226 / 40%);
				animation-delay: 100ms;
			}

			#results .player-result::before {
				position: absolute;
				top: -60%;
				left: -85%;
				width: 38%;
				height: 220%;
				background: linear-gradient(
					90deg,
					transparent,
					rgb(255 255 255 / 16%),
					rgb(95 237 131 / 22%),
					transparent
				);
				transform: rotate(18deg);
				content: '';
				pointer-events: none;
				animation: card-shine 4.5s 650ms ease-in-out infinite;
			}

			#results .player-result h2 {
				margin: 0;
				overflow-wrap: anywhere;
				color: var(--green);
				font-size: 0.85rem;
				text-shadow: 0 0 8px rgb(95 237 131 / 70%);
			}

			#results .player-result:last-child h2 {
				color: #b877ff;
				text-shadow: 0 0 8px rgb(138 43 226 / 80%);
			}

			#results .player-result p {
				margin: 0.5rem 0;
				color: var(--muted);
				font-size: 0.55rem;
			}

			#results .player-result.error {
				border-color: var(--danger);
				box-shadow: 0 0 14px rgb(255 82 119 / 45%);
				color: var(--danger);
			}

			#results .player-result.error::before {
				display: none;
			}

			#results .player-result.error h2,
			#results .player-result.error p {
				color: var(--danger);
				text-shadow: none;
			}

			#results .results-vs {
				display: grid;
				place-items: center;
				width: 3.25rem;
				aspect-ratio: 1;
				border-radius: 50%;
				background: linear-gradient(110deg, var(--green), var(--purple), var(--green));
				background-size: 250% 250%;
				box-shadow:
					0 0 10px var(--green),
					0 0 24px rgb(138 43 226 / 70%);
				color: #fff;
				font-size: 0.65rem;
				font-weight: bold;
				text-shadow: 2px 2px 0 #16072b;
				animation:
					gradient-shift 2.5s linear infinite,
					vs-pulse 1.5s ease-in-out infinite;
			}

			#results .graph-scroll {
				margin-top: 1rem;
				padding: 0.4rem 0 0.7rem;
				overflow-x: auto;
				scrollbar-color: var(--purple) var(--background);
			}

			#results .contribution-graph {
				display: flex;
				justify-content: center;
				gap: 3px;
				min-width: max-content;
			}

			#results .contribution-week {
				display: grid;
				grid-template-rows: repeat(7, 9px);
				gap: 3px;
			}

			#results .contribution-day {
				position: relative;
				width: 9px;
				height: 9px;
				border-radius: 2px;
				border: 1px solid rgb(10 10 26 / 65%);
				transition:
					transform 120ms ease,
					filter 120ms ease,
					box-shadow 120ms ease;
			}

			#results .player-result:first-child .contribution-day:hover {
				z-index: 2;
				filter: brightness(1.35);
				transform: scale(1.7);
				box-shadow: 0 0 5px var(--green), 0 0 10px var(--green);
			}

			#results .player-result:last-child .contribution-day:hover {
				z-index: 2;
				filter: brightness(1.35);
				transform: scale(1.7);
				box-shadow: 0 0 5px var(--purple), 0 0 10px var(--purple);
			}

			#results .winner {
				margin: 0.5rem 0 0;
				color: var(--green);
				font-size: clamp(0.7rem, 2vw, 1rem);
				text-shadow:
					0 0 7px var(--green),
					0 0 18px rgb(138 43 226 / 70%);
				animation: winner-reveal 600ms cubic-bezier(0.2, 1.4, 0.4, 1) both;
			}

			#results .loading-text {
				margin: 1rem 0;
				font-size: 0.7rem;
				animation: loading-colors 900ms ease-in-out infinite alternate;
			}

			@keyframes neon-pulse {
				0%,
				100% {
					opacity: 1;
					text-shadow:
						0 0 4px #fff,
						0 0 10px var(--green),
						0 0 24px var(--green),
						0 0 44px var(--purple);
				}

				48% {
					opacity: 0.9;
					text-shadow:
						0 0 2px #fff,
						0 0 7px var(--green),
						0 0 16px var(--green),
						0 0 30px var(--purple);
				}

				50% {
					opacity: 0.72;
				}

				52% {
					opacity: 1;
				}
			}

			@keyframes gradient-shift {
				to {
					background-position: 200% 50%;
				}
			}

			@keyframes vs-pulse {
				0%,
				100% {
					transform: scale(1) rotate(-2deg);
				}

				50% {
					transform: scale(1.08) rotate(2deg);
				}
			}

			@keyframes float-in-left {
				from {
					opacity: 0;
					transform: translateX(-45px);
				}

				to {
					opacity: 1;
					transform: translateX(0);
				}
			}

			@keyframes float-in-right {
				from {
					opacity: 0;
					transform: translateX(45px);
				}

				to {
					opacity: 1;
					transform: translateX(0);
				}
			}

			@keyframes card-reveal {
				from {
					opacity: 0;
					transform: translateY(20px);
				}

				to {
					opacity: 1;
					transform: translateY(0);
				}
			}

			@keyframes card-shine {
				0%,
				58% {
					left: -85%;
				}

				82%,
				100% {
					left: 150%;
				}
			}

			@keyframes winner-reveal {
				from {
					opacity: 0;
					transform: scale(0.65);
				}

				to {
					opacity: 1;
					transform: scale(1);
				}
			}

			@keyframes loading-colors {
				from {
					color: var(--green);
					text-shadow: 0 0 6px var(--green), 0 0 14px var(--green);
				}

				to {
					color: #b877ff;
					text-shadow: 0 0 6px var(--purple), 0 0 14px var(--purple);
				}
			}

			@media (max-width: 700px) {
				body {
					gap: 1.75rem;
					padding-inline: 0.75rem;
				}

				.fighters {
					flex-direction: column;
				}

				.fighter {
					width: 100%;
					flex-basis: auto;
				}

				#results .results-row {
					grid-template-columns: 1fr;
				}

				#results .results-vs {
					margin: 0 auto;
				}

				#results .contribution-graph {
					justify-content: flex-start;
				}
			}

			@media (prefers-reduced-motion: reduce) {
				*,
				*::before,
				*::after {
					scroll-behavior: auto !important;
					transition-duration: 0.01ms !important;
					animation-duration: 0.01ms !important;
					animation-iteration-count: 1 !important;
				}

				.fighter {
					opacity: 1;
				}
			}
		</style>

		<script>
			const form = document.querySelector<HTMLFormElement>('#battle-form')!;
			const battleButton = document.querySelector<HTMLButtonElement>('#battle-btn')!;
			const results = document.querySelector<HTMLElement>('#results')!;

			interface ContributionDay {
				weekday: number;
				count: number;
				level: number;
			}

			interface ContributionWeek {
				index: number;
				first_day: string;
				contribution_days: ContributionDay[];
			}

			interface ContributionsResponse {
				from: string;
				to: string;
				total_contributions: number;
				colors_full: string[];
				weeks: ContributionWeek[];
			}

			interface FetchOutcome {
				username: string;
				data?: ContributionsResponse;
				error?: string;
			}

			function isContributionsResponse(value: unknown): value is ContributionsResponse {
				if (!value || typeof value !== 'object') {
					return false;
				}

				const data = value as Partial<ContributionsResponse>;
				return (
					typeof data.from === 'string' &&
					typeof data.to === 'string' &&
					typeof data.total_contributions === 'number' &&
					Array.isArray(data.colors_full) &&
					data.colors_full.every((color) => typeof color === 'string') &&
					Array.isArray(data.weeks) &&
					data.weeks.every(
						(week) =>
							typeof week.index === 'number' &&
							typeof week.first_day === 'string' &&
							Array.isArray(week.contribution_days) &&
							week.contribution_days.every(
								(day) =>
									typeof day.weekday === 'number' &&
									typeof day.count === 'number' &&
									typeof day.level === 'number',
							),
					)
				);
			}

			async function fetchContributions(username: string): Promise<FetchOutcome> {
				try {
					const response = await fetch(`/api/contributions/${encodeURIComponent(username)}`);
					const body: unknown = await response.json();
					if (!response.ok) {
						const message =
							body && typeof body === 'object' && 'error' in body && typeof body.error === 'string'
								? body.error
								: 'Something went wrong';
						return { username, error: message };
					}
					if (!isContributionsResponse(body)) {
						return { username, error: 'Received invalid contribution data' };
					}
					return { username, data: body };
				} catch {
					return { username, error: 'Failed to reach the battle arena' };
				}
			}

			function formatDate(date: string): string {
				return new Intl.DateTimeFormat('en', {
					year: 'numeric',
					month: 'short',
					day: 'numeric',
					timeZone: 'UTC',
				}).format(new Date(`${date}T00:00:00Z`));
			}

			function createContributionGraph(data: ContributionsResponse): HTMLElement {
				const scroll = document.createElement('div');
				scroll.className = 'graph-scroll';

				const graph = document.createElement('div');
				graph.className = 'contribution-graph';
				graph.setAttribute('role', 'img');
				graph.setAttribute('aria-label', `Contribution graph from ${formatDate(data.from)} to ${formatDate(data.to)}`);

				for (const week of data.weeks) {
					const weekElement = document.createElement('div');
					weekElement.className = 'contribution-week';

					for (const day of week.contribution_days) {
						const square = document.createElement('span');
						const date = new Date(`${week.first_day}T00:00:00Z`);
						date.setUTCDate(date.getUTCDate() + day.weekday);
						const dateLabel = formatDate(date.toISOString().slice(0, 10));
						const level = Math.max(0, Math.min(day.level, data.colors_full.length - 1));

						square.className = 'contribution-day';
						square.style.backgroundColor = data.colors_full[level] ?? '#ebedf0';
						square.title = `${day.count} contribution${day.count === 1 ? '' : 's'} on ${dateLabel}`;
						square.setAttribute('aria-hidden', 'true');
						weekElement.append(square);
					}

					graph.append(weekElement);
				}

				scroll.append(graph);
				return scroll;
			}

			function createPlayerResult(outcome: FetchOutcome): HTMLElement {
				const card = document.createElement('article');
				card.className = 'player-result';

				const username = document.createElement('h2');
				username.textContent = outcome.username;
				card.append(username);

				if (outcome.error) {
					card.classList.add('error');
					const error = document.createElement('p');
					error.textContent = outcome.error;
					card.append(error);
					return card;
				}

				const data = outcome.data!;
				const total = document.createElement('p');
				total.textContent = `${data.total_contributions.toLocaleString()} contributions`;

				const range = document.createElement('p');
				range.textContent = `${formatDate(data.from)} – ${formatDate(data.to)}`;

				card.append(total, range, createContributionGraph(data));
				return card;
			}

			function renderResults(outcomes: FetchOutcome[]): void {
				const [player1, player2] = outcomes;
				const row = document.createElement('div');
				row.className = 'results-row';

				const versus = document.createElement('span');
				versus.className = 'results-vs';
				versus.textContent = 'VS';
				versus.setAttribute('aria-hidden', 'true');

				row.append(createPlayerResult(player1), versus, createPlayerResult(player2));
				results.replaceChildren(row);

				if (player1.data && player2.data) {
					const winner = document.createElement('p');
					winner.className = 'winner';

					if (player1.data.total_contributions > player2.data.total_contributions) {
						winner.textContent = `🏆 ${player1.username} wins!`;
					} else if (player2.data.total_contributions > player1.data.total_contributions) {
						winner.textContent = `🏆 ${player2.username} wins!`;
					} else {
						winner.textContent = `🤝 It's a tie!`;
					}

					results.append(winner);
				}
			}

			form.addEventListener('submit', async (event) => {
				event.preventDefault();

				const player1 = (document.querySelector<HTMLInputElement>('#player1')!).value.trim();
				const player2 = (document.querySelector<HTMLInputElement>('#player2')!).value.trim();

				if (!player1 || !player2) {
					const error = document.createElement('p');
					error.className = 'player-result error';
					error.textContent = 'Please enter both usernames.';
					results.replaceChildren(error);
					return;
				}

				battleButton.disabled = true;
				battleButton.textContent = 'Battling...';
				const loading = document.createElement('p');
				loading.className = 'loading-text';
				loading.textContent = 'Loading contribution data...';
				results.replaceChildren(loading);

				try {
					const outcomes = await Promise.all([
						fetchContributions(player1),
						fetchContributions(player2),
					]);
					renderResults(outcomes);
				} finally {
					battleButton.disabled = false;
					battleButton.textContent = 'Battle!';
				}
			});
		</script>
	</body>
</html>
